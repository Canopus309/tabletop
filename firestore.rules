rules_version = '2';
// 바둑 AI 온라인 순위표 규칙
// - 누구나 순위표를 읽을 수 있다
// - 익명 로그인한 기기는 자기 문서(players/{자기 uid})만 만들고 고치고 지울 수 있다
// - 값의 종류와 범위를 확인해 엉뚱한 값이 올라오지 않게 한다
service cloud.firestore {
  match /databases/{database}/documents {
    match /players/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid && validPlayer(request.resource.data);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // 체스·오목: 레이팅 순위 (Glicko-2 레이팅·편차, 오목은 화면에서 급수로 표시)
    match /chess/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid && validRated(request.resource.data);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    match /omok/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid && validRated(request.resource.data);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    function validRated(d) {
      return d.keys().hasOnly(['name', 'rating', 'rd', 'games', 'updated'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 12
        && d.rating is number && d.rating >= 100 && d.rating <= 3500
        && d.rd is number && d.rd >= 0 && d.rd <= 400
        && d.games is int && d.games >= 3 && d.games <= 100000
        && d.updated == request.time;
    }

    function validPlayer(d) {
      return d.keys().hasOnly(['name', 'kyu', 'weak', 'strong', 'games', 'moves', 'model', 'updated'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 12
        && d.kyu is number && d.kyu >= -4 && d.kyu <= 20
        && d.weak is number && d.weak >= -4 && d.weak <= 20
        && d.strong is number && d.strong >= -4 && d.strong <= 20
        && d.games is int && d.games >= 3 && d.games <= 10
        && d.moves is int && d.moves >= 10 && d.moves <= 5000
        && d.model is string && d.model.size() <= 8
        && d.updated == request.time;
    }
  }
}
