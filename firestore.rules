rules_version = '2';
// 바둑 AI 온라인 순위표 규칙
// - 누구나 순위표를 읽을 수 있다
// - 익명 로그인한 기기는 자기 문서(players/{자기 uid})만 만들고 고치고 지울 수 있다
// - 값의 종류와 범위를 확인해 엉뚱한 값이 올라오지 않게 한다
service cloud.firestore {
  match /databases/{database}/documents {
    match /players/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid && validPlayer(request.resource.data);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // 체스·오목: 레이팅 순위 (Glicko-2 레이팅·편차, 오목은 화면에서 급수로 표시)
    match /chess/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid && validRated(request.resource.data);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    match /omok/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid && validRated(request.resource.data);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // 바둑 사람 대국 레이팅 (온라인 편지 대국 결과로만 움직인다)
    match /gor/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid && validRated(request.resource.data);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // 증강 바둑 결과 모음 (덤 조정용): 판 크기·두 증강·덤·결과만. 누구나 읽고, 로그인한 기기가 새로 쓰기만
    match /augstats/{id} {
      allow read: if true;
      allow create: if request.auth != null && id.size() <= 20 && validAugStat(request.resource.data);
    }
    function augList() { return ['kowang', 'rewind', 'snipe', 'double', 'invincible', 'barrier', 'wall', 'swap', 'prisoner']; }
    function validAugStat(d) {
      return d.keys().hasOnly(['n', 'ab', 'aw', 'komi', 'w', 'how', 'len', 'local', 'at', 'of', 'bid', 'bwin']) && d.keys().hasAll(['n', 'ab', 'aw', 'komi', 'w', 'how', 'len', 'local', 'at'])
        && d.n in [9, 13, 19] && d.ab in augList() && d.aw in augList() && d.komi is number
        && d.w in [1, 2] && d.how in ['score', 'resign', 'time'] && d.len is int && d.len >= 0 && d.len < 2000
        && d.local is bool && d.at == request.time
        && (!('of' in d) || (d.of is list && d.of.size() <= 2)) && (!('bid' in d) || (d.bid is int && d.bid >= -1 && d.bid <= 80)) && (!('bwin' in d) || d.bwin in [0, 1, 2]);
    }

    // 온라인 대국 (편지 대국, 바둑 g='go' · 증강 바둑 'goaug' · 오목 'omok' · 체스 'chess'). 문서 하나 = 방 하나, 문서 id = 6자리 방 코드
    // 서버 프로그램 없이 규칙만으로 지키는 것: 참가자만 고칠 수 있다, 차례인 사람만 한 수씩 덧붙인다,
    // 기권은 자기 패로만, 시간승은 상대 기한이 지난 뒤에만, 바둑 계가는 한 사람이 제안하고 다른 사람이 동의해야 끝난다,
    // 오목·체스 무승부 합의는 상대가 제안했을 때만. 수가 게임 규칙에 맞는지와 5목·체크메이트 판정은 각 폰이 확인한다
    // 색: bu·bn·bR·bD 는 흑, wu·wn·wR·wD 는 백, 결과 res.w 는 1 흑 / 2 백 / 0 무승부
    match /games/{code} {
      allow get: if true;
      allow list: if request.auth != null && request.auth.uid in resource.data.players;
      allow create: if request.auth != null && code.size() == 6 && validNewGame(request.resource.data);
      allow delete: if request.auth != null && resource.data.host == request.auth.uid && resource.data.st == 'open';
      allow update: if request.auth != null && (joinOk() || (request.auth.uid in resource.data.players
        && (moveOk() || proposeOk() || acceptOk() || resumeOk() || resignOk() || timeOk() || offerOk() || declineOk() || drawOk() || bidOk() || passOk() || chooseOk() || pickTimeOk())));
    }

    function nameOk(n) { return n is string && n.size() <= 12; }
    function validNewGame(d) {
      let me = request.auth.uid;
      return d.keys().hasOnly(['g', 'n', 'komi', 'handi', 'days', 'rated', 'host', 'players', 'bu', 'wu', 'bn', 'wn', 'bR', 'bD', 'wR', 'wD', 'st', 'moves', 'rs', 'mt', 'created', 'ab', 'aw', 'of', 'bv', 'bw', 'bt'])
        && d.keys().hasAll(['g', 'n', 'komi', 'handi', 'days', 'rated', 'host', 'players', 'bu', 'wu', 'bn', 'wn', 'bR', 'bD', 'wR', 'wD', 'st', 'moves', 'rs', 'mt', 'created'])
        && ((d.g == 'go' && d.n in [9, 13, 19] && d.komi in [0.5, 7.5] && d.handi is int && (d.handi == 0 || (d.handi >= 2 && d.handi <= 9)))
          || (d.g == 'goaug' && d.n in [9, 13, 19] && d.komi == 7.5 && d.handi == 0 && d.rated == false && d.ab == '' && d.aw == ''
              && d.of is list && d.of.size() == 2 && d.of[0] in augList() && d.of[1] in augList() && d.of[0] != d.of[1]
              && d.bv == -1 && d.bw == 0 && d.bt in [1, 2])
          || (d.g == 'omok' && d.n == 15 && d.komi == 0 && d.handi == 0)
          || (d.g == 'chess' && d.n == 8 && d.komi == 0 && d.handi == 0))
        && d.days in [1, 3, 7] && d.rated is bool
        && d.host == me && d.players == [me]
        && ((d.bu == me && d.wu == '' && d.wn == '') || (d.wu == me && d.bu == '' && d.bn == ''))
        && nameOk(d.bn) && nameOk(d.wn)
        && d.bR is number && d.bD is number && d.wR is number && d.wD is number
        && d.st == 'open' && d.moves == [] && d.rs == 0 && d.mt == request.time && d.created is int;
    }
    // 차례인 사람의 uid (바둑·오목은 흑이 먼저, 접바둑과 체스는 백이 먼저)
    function blackFirst(o) { return o.g != 'chess' && o.handi < 2; }
    function toMove(o) { return ((o.moves.size() % 2 == 0) == blackFirst(o)) ? o.bu : o.wu; }
    function myColor(o) { return (request.auth.uid == o.bu) ? 1 : 2; }
    // 수 하나의 모양: 바둑·오목은 칸 번호(바둑 0 = 패스), 체스는 'e2e4' · 'e7e8q' 같은 글자, 증강 바둑은 '123' · 'd12,34' 같은 글자 ('0' = 패스)
    function moveShape(o, v) {
      return (o.g == 'chess') ? (v is string && v.size() >= 4 && v.size() <= 5)
        : (o.g == 'goaug') ? (v is string && v.size() >= 1 && v.size() <= 24)
        : (v is int && v >= 0 && (o.g != 'omok' || v < 225));
    }
    function isPass(v) { return v == 0 || v == '0'; }
    function deadlinePassed(o) { return request.time > o.mt + duration.value(o.days, 'd'); }
    // 참가: 빈 자리에 내가 들어간다
    function joinOk() {
      let o = resource.data; let d = request.resource.data; let me = request.auth.uid;
      return o.st == 'open' && !(me in o.players)
        && d.players == o.players.concat([me]) && d.st == ((o.g == 'goaug') ? 'pick' : 'play') && d.mt == request.time
        && ((o.bu == '' && d.bu == me && nameOk(d.bn) && d.bR is number && d.bD is number
              && d.diff(o).affectedKeys().hasOnly(['players', 'bu', 'bn', 'bR', 'bD', 'st', 'mt']))
          || (o.wu == '' && d.wu == me && nameOk(d.wn) && d.wR is number && d.wD is number
              && d.diff(o).affectedKeys().hasOnly(['players', 'wu', 'wn', 'wR', 'wD', 'st', 'mt'])));
    }
    // 한 수: 차례인 사람이 수순 끝에 하나만 덧붙인다. 이어서 두 번 패스하면 계가 단계로
    // (rs: 계가를 멈추고 이어 둔 시점의 수 수. 그 뒤에 나온 두 번 패스만 센다)
    // 첫 수(k == 0)는 앞 수순이 없다: 빈 범위 moves[0:0] 는 규칙 실행 오류가 나서 따로 둔다
    // 오목·체스는 수와 함께 끝낼 수 있다 (5목·체크메이트는 둔 사람 승, 판 가득·스테일메이트 등은 무승부).
    // 수를 두면서 상대의 무승부 제안(offer)을 지울 수 있다 (거절)
    function moveOk() {
      let o = resource.data; let d = request.resource.data; let k = o.moves.size();
      return o.st == 'play' && request.auth.uid == toMove(o) && k < 1000
        && d.diff(o).affectedKeys().hasOnly(['moves', 'st', 'mt', 'res', 'offer']) && d.mt == request.time
        && d.moves.size() == k + 1 && (k == 0 || d.moves[0:k] == o.moves) && moveShape(o, d.moves[k])
        && (!('offer' in d) || (('offer' in o) && d.offer == o.offer))
        && ((o.g == 'go' || o.g == 'goaug')
          ? (!('res' in d) && d.st == ((k >= 1 && k - 1 >= o.rs && isPass(d.moves[k]) && isPass(o.moves[k - 1])) ? 'score' : 'play'))
          : ((d.st == 'play' && !('res' in d)) || (d.st == 'done' && endByMove(o, d))));
    }
    function endByMove(o, d) {
      return d.res.keys().hasOnly(['w', 'how', 'd', 'by']) && d.res.by == request.auth.uid && d.res.d == 0
        && ((d.res.how in ['five', 'mate'] && d.res.w == myColor(o))
          || (d.res.how in ['full', 'stalemate', 'repetition', 'material', 'fifty'] && d.res.w == 0));
    }
    // 증강 경매 (증강 바둑, st 'pick'): of = 증강 둘, bv = 지금 최고 값(-1 없음), bw = 최고 부른 색, bt = 부를 색 (0 = 경매 끝)
    // 부를 차례인 사람이 더 높게 부르거나(값은 판 크기별 상한까지), 이미 누가 불렀으면 그만둘 수 있다.
    // 끝나면 최고 부른 사람이 둘 중 하나를 고르고 남은 것은 상대 것, 덤 = 7.5 ± 낙찰 값 (흑 낙찰이면 +)
    function bidMax(n) { return (n == 9) ? 50 : (n == 13) ? 50 : 80; }
    function bidOk() {
      let o = resource.data; let d = request.resource.data;
      return o.g == 'goaug' && o.st == 'pick' && o.bt != 0 && myColor(o) == o.bt
        && d.diff(o).affectedKeys().hasOnly(['bv', 'bw', 'bt', 'mt']) && d.mt == request.time
        && d.bv is int && d.bv > o.bv && d.bv >= 0 && d.bv <= bidMax(o.n) && d.bw == myColor(o) && d.bt == 3 - o.bt;
    }
    function passOk() {
      let o = resource.data; let d = request.resource.data;
      return o.g == 'goaug' && o.st == 'pick' && o.bt != 0 && o.bv >= 0 && myColor(o) == o.bt
        && d.diff(o).affectedKeys().hasOnly(['bt', 'mt']) && d.mt == request.time && d.bt == 0;
    }
    function chooseOk() {
      let o = resource.data; let d = request.resource.data;
      return o.g == 'goaug' && o.st == 'pick' && o.bt == 0 && myColor(o) == o.bw
        && d.diff(o).affectedKeys().hasOnly(['ab', 'aw', 'komi', 'st', 'mt']) && d.mt == request.time && d.st == 'play'
        && ((d.ab == o.of[0] && d.aw == o.of[1]) || (d.ab == o.of[1] && d.aw == o.of[0]))
        && d.komi == 7.5 + ((o.bw == 1) ? o.bv : -o.bv);
    }
    // 경매에서 할 차례인 사람이 기한 안에 하지 않으면 상대가 시간승으로 끝낼 수 있다
    function pickTimeOk() {
      let o = resource.data; let d = request.resource.data; let me = request.auth.uid;
      return o.g == 'goaug' && o.st == 'pick' && deadlinePassed(o) && myColor(o) != ((o.bt != 0) ? o.bt : o.bw)
        && d.diff(o).affectedKeys().hasOnly(['st', 'res', 'mt']) && d.mt == request.time && d.st == 'done'
        && d.res.keys().hasOnly(['w', 'how', 'd', 'by']) && d.res.by == me && d.res.how == 'time' && d.res.w == myColor(o) && d.res.d == 0;
    }
    // 무승부 제안 (오목·체스): 제안은 offer 에 제안한 사람 uid. 기한(mt)은 바꾸지 않는다
    function offerOk() {
      let o = resource.data; let d = request.resource.data;
      return o.g in ['omok', 'chess'] && o.st == 'play' && !('offer' in o)
        && d.diff(o).affectedKeys().hasOnly(['offer']) && d.offer == request.auth.uid;
    }
    // 제안 거절(상대) · 거두기(제안한 사람)
    function declineOk() {
      let o = resource.data; let d = request.resource.data;
      return o.st == 'play' && ('offer' in o) && d.diff(o).affectedKeys().hasOnly(['offer']) && !('offer' in d);
    }
    // 상대의 무승부 제안에 동의
    function drawOk() {
      let o = resource.data; let d = request.resource.data; let me = request.auth.uid;
      return o.st == 'play' && ('offer' in o) && o.offer != me
        && d.diff(o).affectedKeys().hasOnly(['st', 'res', 'mt', 'offer']) && d.mt == request.time && d.st == 'done'
        && d.res.keys().hasOnly(['w', 'how', 'd', 'by']) && d.res.by == me && d.res.how == 'agree' && d.res.w == 0 && d.res.d == 0;
    }
    // 계가 제안: 죽은 돌 목록과 그에 따른 결과
    function proposeOk() {
      let o = resource.data; let d = request.resource.data;
      return o.st == 'score' && d.diff(o).affectedKeys().hasOnly(['prop', 'mt']) && d.mt == request.time
        && d.prop.keys().hasOnly(['by', 'dead', 'bs', 'ws', 'w', 'd']) && d.prop.by == request.auth.uid
        && d.prop.dead is list && d.prop.w in [1, 2] && d.prop.d is number && d.prop.bs is number && d.prop.ws is number;
    }
    // 동의: 상대의 제안 그대로 끝낸다 (제안한 사람은 상대 기한이 지난 뒤에만)
    function acceptOk() {
      let o = resource.data; let d = request.resource.data; let me = request.auth.uid;
      return o.st == 'score' && ('prop' in o) && (o.prop.by != me || deadlinePassed(o))
        && d.diff(o).affectedKeys().hasOnly(['st', 'res', 'mt']) && d.mt == request.time && d.st == 'done'
        && d.res.keys().hasOnly(['w', 'how', 'd', 'by']) && d.res.by == me
        && d.res.how == 'score' && d.res.w == o.prop.w && d.res.d == o.prop.d;
    }
    // 계가에 동의하지 않으면 이어서 둔다 (제안은 지운다)
    function resumeOk() {
      let o = resource.data; let d = request.resource.data;
      return o.st == 'score' && d.diff(o).affectedKeys().hasOnly(['st', 'prop', 'rs', 'mt']) && d.mt == request.time
        && d.st == 'play' && !('prop' in d) && d.rs == o.moves.size();
    }
    // 기권: 자기 패로만
    function resignOk() {
      let o = resource.data; let d = request.resource.data; let me = request.auth.uid;
      return (o.st == 'play' || o.st == 'score')
        && d.diff(o).affectedKeys().hasOnly(['st', 'res', 'mt']) && d.mt == request.time && d.st == 'done'
        && d.res.keys().hasOnly(['w', 'how', 'd', 'by']) && d.res.by == me
        && d.res.how == 'resign' && d.res.w == ((me == o.bu) ? 2 : 1);
    }
    // 시간승: 상대 차례에 상대 기한이 지났을 때 자기 승으로
    function timeOk() {
      let o = resource.data; let d = request.resource.data; let me = request.auth.uid;
      return o.st == 'play' && me != toMove(o) && deadlinePassed(o)
        && d.diff(o).affectedKeys().hasOnly(['st', 'res', 'mt']) && d.mt == request.time && d.st == 'done'
        && d.res.keys().hasOnly(['w', 'how', 'd', 'by']) && d.res.by == me
        && d.res.how == 'time' && d.res.w == ((me == o.bu) ? 1 : 2);
    }

    function validRated(d) {
      return d.keys().hasOnly(['name', 'rating', 'rd', 'games', 'updated'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 12
        && d.rating is number && d.rating >= 100 && d.rating <= 3500
        && d.rd is number && d.rd >= 0 && d.rd <= 400
        && d.games is int && d.games >= 3 && d.games <= 100000
        && d.updated == request.time;
    }

    function validPlayer(d) {
      return d.keys().hasOnly(['name', 'kyu', 'weak', 'strong', 'games', 'moves', 'model', 'updated'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 12
        && d.kyu is number && d.kyu >= -4 && d.kyu <= 20
        && d.weak is number && d.weak >= -4 && d.weak <= 20
        && d.strong is number && d.strong >= -4 && d.strong <= 20
        && d.games is int && d.games >= 3 && d.games <= 10
        && d.moves is int && d.moves >= 10 && d.moves <= 5000
        && d.model is string && d.model.size() <= 8
        && d.updated == request.time;
    }
  }
}
